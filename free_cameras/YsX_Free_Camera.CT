    <CheatEntry>
      <ID>7</ID>
      <Description>"Unlock Camera Tilt (Pitch) and Set Camera Min Z to Floor"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(tilt_limit_aob,ysx.exe,F3 44 0F 5D C6 F3 41 0F 5F F8) // should be unique
alloc(newmem,$1000,tilt_limit_aob)

label(code)
label(return)

registersymbol(tilt_limit_aob)
registersymbol(tiltlimitfieldup)
registersymbol(tiltlimitfielddown)
registersymbol(orbitRecover)

newmem:

code:
  movss xmm6,[tiltlimitfieldup]
  movss xmm7,[tiltlimitfielddown]
  movss xmm0,[rsp+6C]          // dt
  mulss xmm0,[orbitRecover]    // dt * units per second
  addss xmm12,xmm0             // radius += rate*dt
  minss xmm12,[rsi+7CC]        // never exceed base*zoom
  minss xmm8,xmm6
  jmp return

tiltlimitfielddown:
dd (float)-1.55

tiltlimitfieldup:
dd (float)1.55

orbitRecover:
dd (float)6                    // units/second; set very high for an instant snap-back

tilt_limit_aob:
  jmp newmem
return:

[DISABLE]

tilt_limit_aob:
  db F3 44 0F 5D C6

unregistersymbol(tilt_limit_aob)
unregistersymbol(tiltlimitfieldup)
unregistersymbol(tiltlimitfielddown)
unregistersymbol(orbitRecover)
dealloc(newmem)

