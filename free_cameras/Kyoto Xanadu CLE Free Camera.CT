    <CheatEntry>
      <ID>5</ID>
      <Description>"Force Pause Action (Enable first, F5 pause / F6 unpause)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(freezemonitorinjectionpoint_aob,kyoto_xanadu.exe,F3 41 0F 59 B7 20 03 00 00) // should be unique
aobscanmodule(freezeaction_aob1,kyoto_xanadu.exe,E8 D9 5B 16 00) // should be unique
alloc(newmem,$1000,freezeaction_aob1)
registersymbol(freezemonitorinjectionpoint_aob)
registersymbol(freezeaction_aob1)
registersymbol(freeze)

label(toggleon)
label(toggleoff)
label(code)
label(code1)
label(freeze)
label(return)
label(return1)

newmem:

toggleon:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  sub rsp,28
  mov rcx,74 //VK_F5
  call GetAsyncKeyState
  add rsp,28
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  test ax,8001
  pop rax
  jz toggleoff
  mov [freeze],#1
  jmp code

toggleoff:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  sub rsp,28
  mov rcx,75 //VK_F6
  call GetAsyncKeyState
  add rsp,28
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  test ax,8001
  pop rax
  jz code
  mov [freeze],#0

code:
  mulss xmm6,[r15+00000320]
  jmp return

code1:
  pushf
  cmp [freeze],#0
  je @f
  popf
  jmp return1
@@:
  popf
  call kyoto_xanadu.exe+1A9540
  jmp return1

freeze:
  dd #0

freezemonitorinjectionpoint_aob:
  jmp newmem
  nop 4
return:

freezeaction_aob1:
  jmp code1
return1:

[DISABLE]

freezemonitorinjectionpoint_aob:
db F3 41 0F 59 B7 20 03 00 00

freezeaction_aob1:
  db E8 D9 5B 16 00

unregistersymbol(freezemonitorinjectionpoint_aob)
unregistersymbol(freezeaction_aob1)
unregistersymbol(freeze)
dealloc(newmem)

