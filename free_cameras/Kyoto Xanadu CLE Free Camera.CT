      <ID>2</ID>
      <Description>"Set Custom Camera Distance (F4 Toggle)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(camdist_aob,kyoto_xanadu.exe,F3 0F 10 BB 70 01 00 00) // should be unique
aobscanmodule(unlockcamdist1_aob,kyoto_xanadu.exe,F3 44 0F 11 83 70 01 00 00) // should be unique
aobscanmodule(unlockcamdist2_aob,kyoto_xanadu.exe,F3 0F 11 41 08 48 83 C4) // should be unique
alloc(newmem,$1000,camdist_aob)
alloc(camdist,8)
registersymbol(camdist_aob)
registersymbol(camdist)
registersymbol(camdist_set)
registersymbol(camdist_max)
registersymbol(unlockcamdist1_aob)
registersymbol(unlockcamdist2_aob)

label(code)
label(writecode)
label(camdist_set)
label(camdist_step)
label(camdist_min)
label(camdist_max)
label(return)
label(writereturn)

newmem:

toggleon:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  sub rsp,28
  mov rcx,23 //VK_END
  call GetAsyncKeyState
  add rsp,28
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  test ax,8001
  pop rax
  jz toggleoff
  movss xmm7,[rbx+00000170]
  addss xmm7,[camdist_step]
  minss xmm7,[camdist_max]
  movss [camdist_set],xmm7
  movss [rbx+00000170],xmm7
  jmp code

toggleoff:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  sub rsp,28
  mov rcx,24 //VK_HOME
  call GetAsyncKeyState
  add rsp,28
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  test ax,8001
  pop rax
  jz code
  movss xmm7,[rbx+00000170]
  subss xmm7,[camdist_step]
  maxss xmm7,[camdist_min]
  movss [camdist_set],xmm7
  movss [rbx+00000170],xmm7

code:
  mov [camdist],rbx
  movss xmm7,[rbx+00000170]
  jmp return

writecode:
  cmp [camdist_set],(float)0
  je @f
  movss xmm8,[camdist_set]
@@:
  movss [rbx+00000170],xmm8
  jmp writereturn

camdist_set:
  dd (float)0

camdist_step:
  dd (float)0.3

camdist_min:
  dd (float)0.1

camdist_max:
  dd (float)25

camdist_aob:
  jmp newmem
  nop 3
return:

unlockcamdist1_aob:
  jmp writecode
  nop 4
writereturn:

unlockcamdist2_aob:
  db 90 90 90 90 90

[DISABLE]

camdist_aob:
  db F3 0F 10 BB 70 01 00 00

unlockcamdist1_aob:
  db F3 44 0F 11 83 70 01 00 00

unlockcamdist2_aob:
  db F3 0F 11 41 08

unregistersymbol(unlockcamdist1_aob)
unregistersymbol(unlockcamdist2_aob)
unregistersymbol(camdist_aob)
unregistersymbol(camdist)
unregistersymbol(camdist_set)
unregistersymbol(camdist_max)
dealloc(camdist)
dealloc(newmem)

