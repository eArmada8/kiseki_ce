newmem:

toggleon:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  sub rsp,28
  mov rcx,23 //VK_END
  call GetAsyncKeyState
  add rsp,28
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  test ax,8001
  pop rax
  jz toggleoff
  movss xmm7,[rbx+00000170]
  addss xmm7,[camdist_step]
  minss xmm7,[camdist_max]
  movss [camdist_set],xmm7
  movss [rbx+00000170],xmm7
  jmp code

toggleoff:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  sub rsp,28
  mov rcx,24 //VK_HOME
  call GetAsyncKeyState
  add rsp,28
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  test ax,8001
  pop rax
  jz code
  movss xmm7,[rbx+00000170]
  subss xmm7,[camdist_step]
  maxss xmm7,[camdist_min]
  movss [camdist_set],xmm7
  movss [rbx+00000170],xmm7

code:
  mov [camdist],rbx
  movss xmm7,[rbx+00000170]
  jmp return

writecode:
  cmp [camdist_set],(float)0
  je @f
  movss xmm8,[camdist_set]
@@:
  movss [rbx+00000170],xmm8
  jmp writereturn

camdist_set:
  dd (float)0

camdist_step:
  dd (float)0.3

camdist_min:
  dd (float)0.1

camdist_max:
  dd (float)25

camdist_aob:
  jmp newmem
  nop 3
return:

unlockcamdist1_aob:
  jmp writecode
  nop 4
writereturn:

unlockcamdist2_aob:
  db 90 90 90 90 90

