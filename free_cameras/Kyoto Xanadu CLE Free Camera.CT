<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="42">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Free Camera (Num 0 Toggle)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
globalalloc(speedModifier,8)
speedModifier:
dd (float)3
globalalloc(useMouse,8)
useMouse:
dd (float)0 // 1 to use mouse, 0 to not use mouse
globalalloc(mouseSensitivity,8)
mouseSensitivity:
dd (float)8

aobscanmodule(camera_struct_aob,kyoto_xanadu.exe,48 8B 4B 08 41 0F 28 C8 48 81 C1 68) // should be unique
aobscanmodule(camera_control_aob,kyoto_xanadu.exe,F3 0F 11 7B 4C F3 0F) // should be unique
aobscanmodule(camera_rot_q_aob,kyoto_xanadu.exe,0F 11 83 00 01 00 00 0F 11 A3) // should be unique
aobscanmodule(move_player_aob,kyoto_xanadu.exe,74 08 49 8B D5 E8 CA) // should be unique
alloc(newmem,$100,camera_struct_aob)
alloc(cameracoordinates,$100,camera_struct_aob)
registersymbol(camera_struct_aob)
registersymbol(camera_control_aob)
registersymbol(camera_rot_q_aob)
registersymbol(move_player_aob)
registersymbol(cameracoordinates)

label(code)
label(return)

newmem:

code:
  mov rcx,[rbx+08]
  movaps xmm1,xmm8
  mov [cameracoordinates],rcx
  jmp return

camera_struct_aob:
  jmp newmem
  nop 3
return:

camera_control_aob:
  db 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90 90

camera_rot_q_aob:
  db 90 90 90 90 90 90 90

move_player_aob:
  db EB 08

{$lua}

--Multiplies two quaternions in (w, x, y, z) format.
local function q_multiply(q1, q2)
  local w1, x1, y1, z1 = q1[1], q1[2], q1[3], q1[4]
  local w2, x2, y2, z2 = q2[1], q2[2], q2[3], q2[4]
  return {
    w1*w2 - x1*x2 - y1*y2 - z1*z2,
    w1*x2 + x1*w2 + y1*z2 - z1*y2,
    w1*y2 - x1*z2 + y1*w2 + z1*x2,
    w1*z2 + x1*y2 - y1*x2 + z1*w2
  }
end

--Creates a normalized quaternion from an angle (radians) and an axis tuple.
local function q_from_axis_angle(angle_rad, axis)
  local ax, ay, az = axis[1], axis[2], axis[3]
  local mag = math.sqrt(ax^2 + ay^2 + az^2)
  if mag == 0 then
    return {1.0, 0.0, 0.0, 0.0}
  end
  ax, ay, az = ax/mag, ay/mag, az/mag --Normalize
  local half_angle = angle_rad / 2.0
  local sin_half = math.sin(half_angle)
  return {math.cos(half_angle), ax * sin_half, ay * sin_half, az * sin_half}
end

local function quaternionToLocalAxes(w, x, y, z)
    -- Pre-calculate repeated products for performance
    local x2, y2, z2 = x * x, y * y, z * z
    local xy, xz, yz = x * y, x * z, y * z
    local wx, wy, wz = w * x, w * y, w * z

    -- Extract vectors from rotation matrix columns
    local localX = { 1 - 2 * (y2 + z2),     2 * (xy + wz),     2 * (xz - wy) }
    local localY = {     2 * (xy - wz), 1 - 2 * (x2 + z2),     2 * (yz + wx) }
    local localZ = {     2 * (xz + wy),     2 * (yz - wx), 1 - 2 * (x2 + y2) }

    return localX, localY, localZ
end

local function rotate_quaternion (current_q, direction, angle_degrees)
  local angle_rad = math.rad(angle_degrees)
  local rad, axis
  local localX, localY, localZ = quaternionToLocalAxes(current_q[1],current_q[2],current_q[3],current_q[4])
  
  -- Pitch (Up/Down) rotates on Z-axis. Yaw (Left/Right) rotates on Y-axis.
  if direction == "up" then
    rad, axis = -angle_rad, localZ  -- Negative rotation around Z
  elseif direction == "down" then
    rad, axis = angle_rad, localZ -- Positive rotation around Z
  elseif direction == "left" then
    rad, axis = -angle_rad, localY  -- Negative rotation around Y
  elseif direction == "right" then
    rad, axis = angle_rad, localY -- Positive rotation around Y
  elseif direction == "roll_l" then
    rad, axis = -angle_rad, localX  -- Negative rotation around X
  elseif direction == "roll_r" then
    rad, axis = angle_rad, localX -- Positive rotation around X
  else
    error("Direction must be 'up', 'down', 'left', or 'right'")
  end

  local delta_q = q_from_axis_angle(rad, axis)
  local quat = q_multiply(current_q, delta_q)
  return quat
end

function checkKeys()
  if not (getForegroundProcess() == getOpenedProcessID()) then return end -- Only run if in game
  if (getAddressSafe("[cameracoordinates]")) then
    --Read and assign speed modifier value
    local speed = readFloat("speedModifier")
    local use_mouse = readFloat("useMouse")
    local mouse_speed = readFloat("mouseSensitivity")

    --Camera Coordinates (Read Only)
    local camx = readFloat("[cameracoordinates]+10") -- Camera X
    local camy = readFloat("[cameracoordinates]+18") -- Camera Y
    local camz = readFloat("[cameracoordinates]+14") -- Camera Z

    --Camera Target Coordinates
    local targetx = readFloat("[cameracoordinates]+4C") -- Camera Target X
    local targety = readFloat("[cameracoordinates]+54") -- Camera Target Y
    local targetz = readFloat("[cameracoordinates]+50") -- Camera Target Z

    --Camera Rotation
    local qw = readFloat("[cameracoordinates]+100") -- Camera qw
    local qx = readFloat("[cameracoordinates]+104") -- Camera qx
    local qy = readFloat("[cameracoordinates]+108") -- Camera qy
    local qz = readFloat("[cameracoordinates]+10C") -- Camera qz

    --Camera Distance
    local camdist = readFloat("[cameracoordinates]+170") -- Camera distance

    --Prevent endless error loop if camera status is not initiated
    if (targetz == nil) or (targetz == camz and targetx == camx and targety == camy) then
      speed = 0
      camx = 0
      camy = 0
      camz = 0
      targetx = 0
      targety = 0
      targetz = 0
    else

      local new_mouse_x,new_mouse_y = getMousePos()
      local mouse_loaded = readInteger("cameracoordinates+88")

      --Initialize mouse coordinates on first run (if using mouse)
      if not (mouse_loaded == 1) and (use_mouse == 1) then
        new_mouse_x = getScreenWidth() / 2
        new_mouse_y = getScreenHeight() / 2
        setMousePos(getScreenWidth() / 2, getScreenHeight() / 2)
        writeInteger("cameracoordinates+88",1)
      end

      --Measure mouse movement from previous cycle
      local mouse_move_x = new_mouse_x - getScreenWidth() / 2
      local mouse_move_y = new_mouse_y - getScreenHeight() / 2

      --Camera Location
      local target = {targetx, targety, targetz}
      local current_q = {qw, qx, qy, qz}
      local new_q = {qw, qx, qy, qz}

      --Mouse Rotation in Radians
      --Use math.rad() to convert from degrees if game values aren't in radians
      local camdist = ((targetx - camx)^2 + (targety - camy)^2 + (targetz - camz)^2)^0.5
      local tilt = math.atan2(camz - targetz, ((targetx - camx)^2 + (targety - camy)^2)^0.5)
      local pan = math.atan2(targetx - camx, targety - camy) + math.rad(180) -- Horizontal (pan)

      --Sine and Cosine of Rotation Values
      local siny = math.sin(pan) -- Sine of Horizontal (pan)
      local cosy = math.cos(pan) -- Cosine of Horizontal (pan)
      local sinp = math.sin(tilt) -- Sine of Vertical (tilt)
      local cosp = math.cos(tilt) -- Cosine of Vertical (tilt)

      --Forward
      if isKeyPressed(VK_W) then
        targetx = targetx - (siny * speed * 0.08)
        targety = targety - (cosy * speed * 0.08)
        targetz = targetz - (sinp * speed * 0.08)
      end
      --Left
      if isKeyPressed(VK_A) then
        targetx = targetx + (math.sin(pan - math.rad(90)) * speed * 0.08)
        targety = targety + (math.cos(pan - math.rad(90)) * speed * 0.08)
      end
      --Back
      if isKeyPressed(VK_S) then
        targetx = targetx + (siny * speed * 0.08)
        targety = targety + (cosy * speed * 0.08)
        targetz = targetz + (sinp * speed * 0.08)
      end
      --Right
      if isKeyPressed(VK_D) then
        targetx = targetx - (math.sin(pan - math.rad(90)) * speed * 0.08)
        targety = targety - (math.cos(pan - math.rad(90)) * speed * 0.08)
      end
      --Forward/Right
      if isKeyPressed(VK_W) and isKeyPressed(VK_D) then
        targetx = targetx - (math.sin(pan - math.rad(45)) * speed * 0.08)
        targety = targety - (math.cos(pan - math.rad(45)) * speed * 0.08)
        targetz = targetz - (sinp * speed * 0.08)
      end
      --Forward/Left
      if isKeyPressed(VK_W) and isKeyPressed(VK_A) then
        targetx = targetx - (math.sin(pan + math.rad(45)) * speed * 0.08)
        targety = targety - (math.cos(pan + math.rad(45)) * speed * 0.08)
        targetz = targetz - (sinp * speed * 0.08)
      end
      --Back/Left
      if isKeyPressed(VK_S) and isKeyPressed(VK_A) then
        targetx = targetx + (math.sin(pan - math.rad(45)) * speed * 0.08)
        targety = targety + (math.cos(pan - math.rad(45)) * speed * 0.08)
        targetz = targetz + (sinp * speed * 0.08)
      end
      --Back/Right
      if isKeyPressed(VK_S) and isKeyPressed(VK_D) then
        targetx = targetx + (math.sin(pan + math.rad(45)) * speed * 0.08)
        targety = targety + (math.cos(pan + math.rad(45)) * speed * 0.08)
        targetz = targetz + (sinp * speed * 0.08)
      end
      --Up
      if isKeyPressed(VK_R) then
       targetz = targetz + (speed * 0.06)
      end
      --Down
      if isKeyPressed(VK_F) then
       targetz = targetz - (speed * 0.06)
      end
      --Roll right
      if isKeyPressed(VK_NUMPAD9) then
        new_q = rotate_quaternion(current_q, 'roll_r', speed * 0.3)
      end
      --Roll left
      if isKeyPressed(VK_NUMPAD7) then
        new_q = rotate_quaternion(current_q, 'roll_l', speed * 0.3)
      end
      --Pan right
      if isKeyPressed(VK_NUMPAD6) then
        new_q = rotate_quaternion(current_q, 'right', speed * 0.3)
      end
      --Pan left
      if isKeyPressed(VK_NUMPAD4) then
        new_q = rotate_quaternion(current_q, 'left', speed * 0.3)
      end
      --Tilt up
      if isKeyPressed(VK_NUMPAD8) then
        new_q = rotate_quaternion(current_q, 'up', speed * 0.3)
      end
      --Tilt down
      if isKeyPressed(VK_NUMPAD5) then
        new_q = rotate_quaternion(current_q, 'down', speed * 0.3)
      end

      if (use_mouse == 1) then
        --Tilt by mouse
        if not(mouse_move_y == 0) then
          new_q = rotate_quaternion(current_q, 'down', mouse_move_y * mouse_speed * 0.1)
        end
        --Pan by mouse
        if not(mouse_move_x == 0) then
          new_q = rotate_quaternion(current_q, 'right', mouse_move_y * mouse_speed * 0.1)
        end

        setMousePos(getScreenWidth() / 2, getScreenHeight() / 2)
      end

      --Write new values into the temporary buffer
      --Camera Target
      writeFloat("cameracoordinates+18", targetx)
      writeFloat("cameracoordinates+20", targety)
      writeFloat("cameracoordinates+1C", targetz)
      --Camera Quaternion
      writeFloat("cameracoordinates+30", new_q[1])
      writeFloat("cameracoordinates+34", new_q[2])
      writeFloat("cameracoordinates+38", new_q[3])
      writeFloat("cameracoordinates+3C", new_q[4])

      --Copy buffer back into memory read by game engine
      copyMemory("cameracoordinates+18",12,"[cameracoordinates]+4C")
      copyMemory("cameracoordinates+30",16,"[cameracoordinates]+100")
    end


    --Speed Modifiers
    if isKeyPressed(VK_F3) then --If F3 is pressed, quadruple the speed
      writeFloat("speedModifier", 12)
    elseif isKeyPressed(VK_F2) then --If F2 is pressed, double the speed
      writeFloat("speedModifier", 6)
    elseif isKeyPressed(VK_F1) then --If F1 is pressed, slow way down
      writeFloat("speedModifier", .5)
    else --If nothing is pressed, speed is normal
      writeFloat("speedModifier", 3)
    end

    --Mouse Support
    if isKeyPressed(VK_PRIOR) then --If Page Up is pressed, enable mouse
      writeFloat("useMouse", 1)
    elseif isKeyPressed(VK_NEXT) then --If Page Down is pressed, disable mouse
      writeFloat("useMouse", 0)
    end
  end
end

t=createTimer(nil)
timer_setInterval(t, 10)
timer_onTimer(t, checkKeys)
timer_setEnabled(t, true)

{$asm}

[DISABLE]
{$lua}

timer_setEnabled(t, false)

{$asm}
