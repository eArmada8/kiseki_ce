    <CheatEntry>
      <ID>2</ID>
      <Description>"Force Pause Action (Enable first, F5 pause / F6 unpause)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

aobscanmodule(forcepauseinject_aob,hnk.exe,39 AF 88 4E 00 00) // should be unique
aobscanmodule(forcepause_aob,hnk.exe,FF 50 18 F3 0F 10 83 7C 4E 00 00) // should be unique
alloc(newmem,$1000,forcepauseinject_aob)

label(toggleon)
label(toggleoff)
label(code)
label(pausecode)
label(freeze)
label(return)
label(pausereturn)

registersymbol(forcepauseinject_aob)
registersymbol(forcepause_aob)
registersymbol(freeze)

newmem:

toggleon:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  sub rsp,28
  mov rcx,74 //VK_F5
  call GetAsyncKeyState
  add rsp,28
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  test ax,8001
  pop rax
  jz toggleoff
  mov [freeze],#1
  jmp code

toggleoff:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  sub rsp,28
  mov rcx,75 //VK_F6
  call GetAsyncKeyState
  add rsp,28
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  test ax,8001
  pop rax
  jz code
  mov [freeze],#0

code:
  cmp [rdi+00004E88],ebp
  jmp return

pausecode:
  pushf
  cmp [freeze],#0
  je @f
  popf
  mov rcx,[rbx+1DA8]        // scene (RBX = G, preserved across calls)
  add rcx,10                // camera object
  xorps xmm1,xmm1           // shakeEnable = 0 (freezes screen shake)
  call hnk.exe+1E8A20       // Camera_UpdateOrbitAndCommit -> your +1E8C32 hook fires
  mov rcx,[rbx+1DA8]
  add rcx,10
  mov dl,1                  // useCommitted = 1 (B20/B30 = free cam)
  mov r8d,1                 // applyShake (no-op since shake disabled)
  call hnk.exe+1E8D30       // Camera_BuildViewProjection
  movss xmm0,[rbx+00004E7C]
  jmp pausereturn
@@:
  popf
  call qword ptr [rax+18]
  movss xmm0,[rbx+00004E7C]
  jmp pausereturn

freeze:
  dd #0

forcepauseinject_aob:
  jmp newmem
  nop
return:

forcepause_aob:
  jmp pausecode
  nop 6
pausereturn:

[DISABLE]

forcepauseinject_aob:
  db 39 AF 88 4E 00 00

forcepause_aob:
  db FF 50 18 F3 0F 10 83 7C 4E 00 00

unregistersymbol(forcepauseinject_aob)
unregistersymbol(forcepause_aob)
unregistersymbol(freeze)
dealloc(newmem)

