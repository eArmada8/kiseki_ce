  db F3 0F 5D 05 CB 9D A8 00

mv_tilt_limit_aob_down:
  db F3 0F 10 05 8B BB A8 00

mv_zoom_in_aob:
  db C7 45 40 00 00 80 3F
  
mv_height_limit_aob:
  db F3 0F 58 0D 2C 99 A8 00 48 8B 41 08


