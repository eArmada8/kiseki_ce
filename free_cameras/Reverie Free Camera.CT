      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

aobscanmodule(mv_tilt_limit_aob_up,hnk.exe,F3 0F 5D 05 CB 9D A8 00) // should be unique
aobscanmodule(mv_tilt_limit_aob_down,hnk.exe,F3 0F 10 05 8B BB A8 00) // should be unique
aobscanmodule(mv_zoom_in_aob,hnk.exe,C7 45 40 00 00 80 3F 44) // should be unique
aobscanmodule(mv_height_limit_aob,hnk.exe,F3 0F 58 0D 2C 99 A8 00) // should be unique
alloc(newmem,$1000,mv_tilt_limit_aob_down)

