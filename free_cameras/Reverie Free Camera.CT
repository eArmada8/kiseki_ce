registersymbol(mv_tilt_limit_aob_down)
registersymbol(mv_zoom_in_aob)
registersymbol(mv_height_limit_aob)
registersymbol(tiltlimitviewerup)
registersymbol(tiltlimitviewerdown)
registersymbol(heightlimitviewerfloor)

newmem:

code_up:
  movss xmm0,[tiltlimitviewerup]
  jmp return_up

code_down:
  movss xmm0,[tiltlimitviewerdown]
  jmp return_down

code_zoom:
  mov [rbp+40],(float)0.01
  jmp return_zoom

code_height:
  addss xmm1,[heightlimitviewerfloor]
  mov rax,[rcx+08]
  mov [rax+18],(float)5 //height max
  jmp return_height

tiltlimitviewerup:
dd (float)1.55

tiltlimitviewerdown:
dd (float)-1.55

heightlimitviewerfloor:
dd (float)-1

mv_tilt_limit_aob_up:
  jmp code_up
  nop 3
return_up:

mv_tilt_limit_aob_down:
  jmp code_down
  nop 3
return_down:

mv_zoom_in_aob:
  jmp code_zoom
  nop 2
return_zoom:

mv_height_limit_aob:
  jmp code_height
  nop 7
return_height:

[DISABLE]

