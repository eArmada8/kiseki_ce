alloc(camerastatus,8)

label(code)
label(return)

registersymbol(camera_aob)
registersymbol(camerastatus)

newmem:
  mov [camerastatus],rcx

code:
  mov [rcx+00000B10],ax
  jmp return

camera_aob:
  jmp newmem
  nop 2
return:

