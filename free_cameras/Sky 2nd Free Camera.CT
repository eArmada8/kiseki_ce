aobscanmodule(freezemonitorinjectionpoint_aob,sora_2nd.exe,0F 28 C6 F3 41 0F 11 B7 E0 02 00 00) // should be unique
aobscanmodule(freezeaction_aob1,sora_2nd.exe,E8 57 68 26 00) // should be unique
